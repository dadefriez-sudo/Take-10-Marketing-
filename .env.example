# ---------------------------------------------------------------------------
# Take 10 Marketing — environment
# Copy to .env and fill in. Nothing here is required to run locally except
# DATABASE_URL and AUTH_SECRET; every integration falls back to a mock provider
# when its key is absent, so the whole app is usable before you have accounts.
# ---------------------------------------------------------------------------

# Postgres. Local dev, Neon, or Supabase all work.
DATABASE_URL="postgresql://take10:take10@127.0.0.1:5432/take10_dev?schema=public"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"

# Public origin, used for magic links, invite links, and (later) webhook URLs.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Providers. All optional. Leave blank and the mock implementation is used —
# outbound email/SMS is captured at /dev/inbox instead of being sent.
# ---------------------------------------------------------------------------

# Email (Phase 2). Resend or Postmark.
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
EMAIL_FROM="Take 10 Marketing <hello@example.com>"

# SMS + voice (Phase 2/5). Requires A2P/10DLC registration before US SMS works.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Google (Phase 3 calendar sync, Phase 4 Business Profile reviews).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Payments (Phase 3 booking deposits).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
